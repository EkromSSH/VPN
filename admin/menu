clear

python3 - << 'EOF'
import os, sys, subprocess, platform

# Colors
RESET   = '\033[0m'
BOLD    = '\033[1m'
CYAN    = '\033[1;36m'
GREEN   = '\033[1;32m'
WHITE   = '\033[1;37m'
GOLD    = '\033[1;38;5;220m'
VAL     = '\033[1;38;5;157m'
RED     = '\033[1;38;5;203m'
GRAY    = '\033[38;5;244m'
LINE    = '\033[1;36m────────────────────────────────────────────────────\033[0m'

def get_os():
    try:
        with open('/etc/os-release') as f:
            for line in f:
                if line.startswith('PRETTY_NAME='):
                    return line.split('=', 1)[1].strip().strip('"')
    except: pass
    return platform.system()

def get_uptime():
    try:
        with open('/proc/uptime') as f:
            sec = float(f.readline().split()[0])
        d = int(sec // 86400)
        h = int((sec % 86400) // 3600)
        m = int((sec % 3600) // 60)
        p = []
        if d > 0: p.append(f"{d}d")
        if h > 0: p.append(f"{h}h")
        p.append(f"{m}m")
        return " ".join(p)
    except: return "-"

def get_mem():
    try:
        mem = {}
        with open('/proc/meminfo') as f:
            for l in f:
                parts = l.split(':')
                if len(parts) == 2:
                    mem[parts[0].strip()] = int(parts[1].split()[0])
        tot = mem.get('MemTotal', 0) // 1024
        avail = mem.get('MemAvailable', 0) // 1024
        used = tot - avail
        pct = int(used * 100 / tot) if tot else 0
        return f"{used} MB / {tot} MB ({pct}%)"
    except: return "-"

def get_cpu():
    try:
        with open('/proc/loadavg') as f:
            lavg = f.readline().split()[0]
        cores = os.cpu_count() or 1
        return f"{lavg} ({cores} คอร์)"
    except: return "-"

def get_ip():
    for path in ['/root/ipvps', '/etc/xray/ipvps']:
        if os.path.exists(path):
            try:
                ip = open(path).read().strip()
                if ip: return ip
            except: pass
    try:
        r = subprocess.run("ip -o -4 route get 8.8.8.8 2>/dev/null | awk '{print $7}'", shell=True, capture_output=True, text=True, timeout=2)
        ip = r.stdout.strip()
        if ip: return ip
    except: pass
    return "82.26.104.61"

def get_domain():
    for path in ['/etc/xray/domain', '/root/domain']:
        if os.path.exists(path):
            try:
                d = open(path).read().strip()
                if d: return d
            except: pass
    return "ไม่มีโดเมน"

def count_db(path):
    try:
        if not os.path.exists(path): return 0
        with open(path, 'r', errors='ignore') as f:
            return sum(1 for line in f if '###' in line)
    except: return 0

os_str     = get_os()[:26]
kernel_str = platform.release()[:26]
ip_str     = get_ip()[:26]
domain_str = get_domain()[:26]
mem_str    = get_mem()
cpu_str    = get_cpu()
uptime_str = get_uptime()

c_ssh = count_db('/etc/ssh/.ssh.db')
c_vm  = count_db('/etc/vmess/.vmess.db')
c_vl  = count_db('/etc/vless/.vless.db')
c_v2  = c_vm + c_vl
c_tr  = count_db('/etc/trojan/.trojan.db')
c_ss  = count_db('/etc/shadowsocks/.shadowsocks.db')

print(LINE)
print('         \033[1;38;5;51m⚡  EKROM VPN SSH CONTROL PANEL  ⚡\033[0m')
print('        \033[0;37mระบบจัดการเซิร์ฟเวอร์ VPN & SSH ประสิทธิภาพสูง\033[0m')
print(LINE)
print(f' {GOLD}ระบบปฏิบัติการ{RESET}   : {VAL}{os_str}{RESET}')
print(f' {GOLD}เคอร์เนล OS{RESET}      : {VAL}{kernel_str}{RESET}')
print(f' {GOLD}RAM เซิร์ฟเวอร์{RESET}  : {VAL}{mem_str}{RESET}')
print(f' {GOLD}โหลด CPU{RESET}         : {VAL}{cpu_str}{RESET}')
print(f' {GOLD}เวลาเซิร์ฟเวอร์{RESET}  : {VAL}{uptime_str}{RESET}')
print(f' {GOLD}IP VPS{RESET}           : {VAL}{ip_str}{RESET}')
print(f' {GOLD}โดเมน{RESET}            : {VAL}{domain_str}{RESET}')
print(LINE)
print(f'    SSH: {VAL}{c_ssh}{RESET}  │  V2RAY: {VAL}{c_v2}{RESET}  │  TROJAN: {VAL}{c_tr}{RESET}  │  SS: {VAL}{c_ss}{RESET}')
print(LINE)

rows = [
    ('[01] จัดการ SSH OVPN',          10, '[08] ข้อมูลพอร์ต VPS'),
    ('[02] จัดการ VMESS',             13, '[09] ข้อมูลโหลด VPS'),
    ('[03] จัดการ VLESS',             13, '[10] ทดสอบความเร็ว'),
    ('[04] จัดการ TROJAN',            12, '[11] เปลี่ยนโดเมน'),
    ('[05] จัดการ SHADWSOCK',          9, '[12] เปลี่ยนแบนเนอร์'),
    ('[06] ระบบที่กำลังทำงาน',         8, '[13] รีสตาร์ทบริการ'),
    ('[07] สำรองและกู้คืน',           11, '[14] รีสตาร์ทเซิร์ฟเวอร์'),
    ('[15] เปลี่ยน DNS',              14, '[16] ตรวจสอบ NETFLIX'),
    ('[17] SWAP RAM',                 17, '[18] เปลี่ยน XRAYCORE'),
    ('[19] ติดตั้ง UDP',              14, '[20] ติดตั้ง BBRPLUS'),
    ('[21] Web Panel (8888)',          9, '[22] ติดตั้ง Web Panel')
]

for c1, sp, c2 in rows:
    c1_col = f'{GREEN}{c1[:4]}{RESET} {WHITE}{c1[5:]}{RESET}'
    c2_col = f'{GREEN}{c2[:4]}{RESET} {WHITE}{c2[5:]}{RESET}'
    print(f'\033[1;36m│\033[0m  {c1_col}{" " * sp}{c2_col}')

print(LINE)
print(f'  {RED}[00]{RESET} {WHITE}ปิดเมนู / ออกจากระบบ (Exit){RESET}')
print(LINE)

EOF

