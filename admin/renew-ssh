#!/bin/bash
clear
red() { echo -e "\\\\033[32;1m${*}\\\\033[0m"; }

# ── ฟังก์ชัน quota (เหมือน add-ssh) ──
del_quota_rules() {
  local uid_num="$1"
  [ -z "$uid_num" ] && return 0
  local nums
  nums=$(iptables -L OUTPUT -n --line-numbers 2>/dev/null | grep "owner UID match $uid_num" | awk '{print $1}' | sort -rn)
  for n in $nums; do
    iptables -D OUTPUT "$n" 2>/dev/null
  done
}

set_quota() {
  local u="$1" gb="$2"
  [ -z "$gb" ] && gb=0
  [ "$gb" -eq 0 ] 2>/dev/null && return 0
  local uid_num=$(id -u "$u")
  local bytes=$((gb * 1024 * 1024 * 1024))
  del_quota_rules "$uid_num"
  iptables -I OUTPUT -m owner --uid-owner "$uid_num" -m quota --quota "$bytes" -j ACCEPT
  iptables -I OUTPUT -m owner --uid-owner "$uid_num" -j REJECT
  echo "✓ ตั้ง quota ${gb}GB ให้ $u แล้ว"
}

echo -e "\033[1;93m─────────────────────────────────────────\033[0m"
echo -e "\e[42m                 ต่ออายุผู้ใช้             \E[0m"
echo -e "\033[1;93m─────────────────────────────────────────\033[0m"
read -p "ชื่อผู้ใช้:" User

if getent passwd $User >/dev/null 2>&1; then
    ok="ok"
else
    echo -e "ล้มเหลว: ผู้ใช้ $User ไม่พบ."
    echo ""
    read -n 1 -s -r -p "กดปุ่มใดๆ เพื่อกลับไปที่เมนู"
    menu
fi

if [ -z $User ]; then
    echo -e "ชื่อผู้ใช้ไม่สามารถเว้นว่างได้"
    echo ""
    read -n 1 -s -r -p "กดปุ่มใดๆ เพื่อกลับไปที่เมนู"
    menu
fi

egrep "^$User" /etc/passwd >/dev/null
if [ $? -eq 0 ]; then
    # อ่านค่า GB/IP เดิมจาก .ssh.db
    OLD_GB=$(grep "^### $User " /etc/ssh/.ssh.db | awk '{print $4}')
    OLD_IP=$(grep "^### $User " /etc/ssh/.ssh.db | awk '{print $5}')
    [ -z "$OLD_GB" ] && OLD_GB=0
    [ -z "$OLD_IP" ] && OLD_IP=0

    read -p "ขยายวัน:" Days
    if [ -z $Days ]; then
        Days="1"
    fi
    read -p "กำหนด GB (เดิม $OLD_GB, Enter=คงเดิม, 0=ไม่จำกัด):" NEW_GB
    [ -z "$NEW_GB" ] && NEW_GB=$OLD_GB
    read -p "ลิมิต IP (เดิม $OLD_IP, Enter=คงเดิม, 0=ไม่จำกัด):" NEW_IP
    [ -z "$NEW_IP" ] && NEW_IP=$OLD_IP

    Today=$(date +%s)
    Days_Detailed=$(($Days * 86400))
    Expire_On=$(($Today + $Days_Detailed))
    Expiration=$(date -u --date="1970-01-01 $Expire_On sec GMT" +%Y/%m/%d)
    Expiration_Display=$(date -u --date="1970-01-01 $Expire_On sec GMT" '+%d %b %Y')
    passwd -u $User
    usermod -e $Expiration $User
    egrep "^$User" /etc/passwd >/dev/null
    echo -e "$Pass\n$Pass\n" | passwd $User &>/dev/null

    # อัปเดต .ssh.db + ตั้ง quota ใหม่
    sed -i "/^### $User /d" /etc/ssh/.ssh.db
    echo "### $User $Expire_On $NEW_GB $NEW_IP" >>/etc/ssh/.ssh.db
    if [ -n "$NEW_GB" ] && [ "$NEW_GB" != "0" ]; then
        set_quota "$User" "$NEW_GB"
    else
        del_quota_rules "$(id -u $User)"
    fi

    clear
    echo -e "\033[1;93m─────────────────────────────────────────\033[0m"
    echo -e "\e[42m                 ต่ออายุผู้ใช้             \E[0m"
    echo -e "\033[1;93m─────────────────────────────────────────\033[0m"
    echo -e "   ชื่อผู้ใช้   : $User"
    echo -e "   เพิ่มวัน : $Days วัน"
    echo -e "   หมดอายุใน : $Expiration_Display"
    echo -e "   โควต้า      : $NEW_GB GB | ลิมิต IP: $NEW_IP เครื่อง"
else
    clear
    echo -e "\033[1;93m─────────────────────────────────────────\033[0m"
    echo -e "\e[42m                 ต่ออายุผู้ใช้             \E[0m"
    echo -e "\033[1;93m─────────────────────────────────────────\033[0m"
    echo -e "ไม่พบชื่อผู้ใช้      "
fi
echo ""
read -n 1 -s -r -p "กดปุ่มใดๆ เพื่อกลับไปที่เมนู"
menu