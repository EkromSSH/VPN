#!/bin/bash
# ═══════════════════════════════════════════════════════════
#  PORT SERVICE INFO — แสดงพอร์ตปัจจุบัน (อ่านจาก config จริง)
#  อัปเดตอัตโนมัติเมื่อเปลี่ยนพอร์ตผ่านเว็บ/เมนู
# ═══════════════════════════════════════════════════════════
clear
NC='\033[0m'
Y='\033[0;33m'
G='\033[0;32m'
C='\033[0;36m'

# ── อ่านค่าจริงจากระบบ ──
HAPROXY_CFG="/etc/haproxy/haproxy.cfg"
TUN_CFG="/etc/websocket/tun.conf"

# พอร์ต SSH WS (public — จาก haproxy bind)
WS_PUB=$(grep -oP 'bind \*:\K[0-9]+' "$HAPROXY_CFG" 2>/dev/null | head -1)
# พอร์ต websocket ภายใน (จาก tun.conf หรือ backend haproxy)
WS_INT=$(grep -oP 'listen_port:\s*\K[0-9]+' "$TUN_CFG" 2>/dev/null | head -1)
[ -z "$WS_INT" ] && WS_INT=$(grep -oP 'ws-local 127\.0\.0\.1:\K[0-9]+' "$HAPROXY_CFG" 2>/dev/null | head -1)
# ค่าเริ่มต้นถ้าไม่พบ
[ -z "$WS_PUB" ] && WS_PUB=80
[ -z "$WS_INT" ] && WS_INT=8080

# พอร์ตอื่นๆ ที่ตรวจจากระบบ (ss = พอร์ตที่ listen จริง)
PORT_SSH=22
PORT_DROPBEAR=$(ss -tlnp 2>/dev/null | grep dropbear | grep -oE ':[0-9]+ ' | grep -oE '[0-9]+' | sort -u | tr '\n' ',' | sed 's/,$//')
[ -z "$PORT_DROPBEAR" ] && PORT_DROPBEAR="109"
PORT_OVPN_TCP=1194
PORT_OVPN_UDP=2200
PORT_SQUID=$(grep -oP 'http_port \K[0-9]+' /etc/squid/squid.conf 2>/dev/null | head -1)
[ -z "$PORT_SQUID" ] && PORT_SQUID=3128
SQUID_ST=$(systemctl is-active squid 2>/dev/null)
[ "$SQUID_ST" = "active" ] && SQUID_ST="ON" || SQUID_ST="OFF"

# BadVPN
B1=$(ss -tln | grep -q ':7100 ' && echo "ON" || echo "OFF")
B2=$(ss -tln | grep -q ':7200 ' && echo "ON" || echo "OFF")
B3=$(ss -tln | grep -q ':7300 ' && echo "ON" || echo "OFF")

echo -e "${Y} ┌──────────────────────────────────────────┐${NC}"
echo -e "${Y} │${NC}            ${G}PORT SERVICE INFO${NC}             ${Y}|${NC}"
echo -e "${Y} └──────────────────────────────────────────┘${NC}"
echo -e "${Y}┌─────────────────────────────────────────────┐${NC}"
echo -e "${Y}│       >>> Service & Port  (อัตโนมัติ)        │${NC}"
echo -e "${Y}│   - SSH Websocket (public)  : ${G}${WS_PUB}${NC}${Y}         │${NC}"
echo -e "${Y}│   - SSH WS Internal         : ${C}${WS_INT}${NC}${Y}         │${NC}"
echo -e "${Y}│   - Open SSH                : $PORT_SSH            │${NC}"
echo -e "${Y}│   - Dropbear                : $PORT_DROPBEAR         │${NC}"
echo -e "${Y}│   - SSH Websocket SSL       : 443           │${NC}"
echo -e "${Y}│   - OpenVPN TCP             : 443, 1194     │${NC}"
echo -e "${Y}│   - OpenVPN UDP             : $PORT_OVPN_UDP          │${NC}"
echo -e "${Y}│   - Nginx Webserver         : 443, 80, 81   │${NC}"
echo -e "${Y}│   - Haproxy Loadbalancer    : 443, $WS_PUB     │${NC}"
echo -e "${Y}│   - DNS Server              : 443, 53       │${NC}"
echo -e "${Y}│   - DNS Client              : 443, 88       │${NC}"
echo -e "${Y}│   - XRAY Vmess TLS          : 443           │${NC}"
echo -e "${Y}│   - XRAY Vless TLS          : 443           │${NC}"
echo -e "${Y}│   - Trojan WS               : 443           │${NC}"
echo -e "${Y}│   - Shadowsocks WS          : 443           │${NC}"
echo -e "${Y}│   - BadVPN 1                : 7100 [${B1}]    │${NC}"
echo -e "${Y}│   - BadVPN 2                : 7200 [${B2}]    │${NC}"
echo -e "${Y}│   - BadVPN 3                : 7300 [${B3}]    │${NC}"
echo -e "${Y}│   - Proxy Squid             : $PORT_SQUID [${SQUID_ST}]  │${NC}"
echo -e "${Y}└─────────────────────────────────────────────┘${NC}"
echo ""
echo -e "${C}💡 เปลี่ยนพอร์ต SSH WS ได้ที่: เมนู 21 (Web Panel) → เปลี่ยนพอร์ต SSH WS${NC}"
echo ""
read -n 1 -s -r -p "กดปุ่มใดก็ได้เพื่อกลับไปที่เมนู"
menu
