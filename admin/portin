#!/bin/bash
# ═══════════════════════════════════════════════════════════
#  PORT SERVICE INFO — แสดงพอร์ตปัจจุบัน (อ่านจาก config จริง)
#  v3: จัดเส้นขอบให้ตรงทุกบรรทัด (นับความกว้างไทย/อังกฤษ)
# ═══════════════════════════════════════════════════════════
clear
NC='\033[0m'
Y='\033[0;33m'
G='\033[0;32m'
C='\033[0;36m'
W='\033[1;37m'

# ── ฟังก์ชันจัดตำแหน่ง (คืน label + เติมช่องว่างให้ครบ w ช่อง) ──
pad_col() {
  local s="$1" w="$2"
  python3 -c "
import sys, unicodedata
s = sys.argv[1]
w = int(sys.argv[2])
length = 0
for c in s:
    if unicodedata.combining(c):
        continue
    length += 2 if ord(c) > 0x7F else 1
sys.stdout.write(s + ' ' * max(0, w - length))
" "$s" "$w"
}

# ── อ่านค่าจริงจากระบบ ──
HAPROXY_CFG="/etc/haproxy/haproxy.cfg"
TUN_CFG="/etc/websocket/tun.conf"

WS_PUB=$(grep -oP 'bind \*:\K[0-9]+' "$HAPROXY_CFG" 2>/dev/null | head -1)
WS_INT=$(grep -oP 'listen_port:\s*\K[0-9]+' "$TUN_CFG" 2>/dev/null | head -1)
[ -z "$WS_INT" ] && WS_INT=$(grep -oP 'ws-local 127\.0\.0\.1:\K[0-9]+' "$HAPROXY_CFG" 2>/dev/null | head -1)
[ -z "$WS_PUB" ] && WS_PUB=80
[ -z "$WS_INT" ] && WS_INT=8080

# Xray port (443 → ย้ายเป็น 4443 ถ้ามี ssh-ws-ssl.conf)
XRAY_PORT=$(grep -oP 'listen \K[0-9]+(?= ssl http2)' /etc/nginx/conf.d/xray.conf 2>/dev/null | head -1)
[ -z "$XRAY_PORT" ] && XRAY_PORT=4443
# SSH WS SSL (443 ถ้ามี config)
WS_SSL=443
[ -f /etc/nginx/conf.d/ssh-ws-ssl.conf ] && WS_SSL=443 || WS_SSL="-"

PORT_SSH=22
PORT_DROPBEAR=$(ss -tlnp 2>/dev/null | grep dropbear | grep -oE ':[0-9]+ ' | grep -oE '[0-9]+' | sort -u | tr '\n' ',' | sed 's/,$//')
[ -z "$PORT_DROPBEAR" ] && PORT_DROPBEAR="109"
PORT_OVPN_UDP=2200
PORT_SQUID=$(grep -oP 'http_port \K[0-9]+' /etc/squid/squid.conf 2>/dev/null | head -1)
[ -z "$PORT_SQUID" ] && PORT_SQUID=3128
SQUID_ST=$(systemctl is-active squid 2>/dev/null)
[ "$SQUID_ST" = "active" ] && SQUID_ST="ON" || SQUID_ST="OFF"
B1=$(ss -tln | grep -q ':7100 ' && echo "ON" || echo "OFF")
B2=$(ss -tln | grep -q ':7200 ' && echo "ON" || echo "OFF")
B3=$(ss -tln | grep -q ':7300 ' && echo "ON" || echo "OFF")

# ── แสดงผล (ทุกบรรทัดกว้าง 46 ช่อง — เส้นขวาตรงกัน) ──
WIDTH=46
BORDER="──────────────────────────────────────────────"

echo -e "${Y}┌─$BORDER─┐${NC}"
echo -e "${Y}│${NC} $(pad_col 'PORT SERVICE INFO' 44) ${Y}│${NC}"
echo -e "${Y}├─$BORDER─┤${NC}"
echo -e "${Y}│${NC} $(pad_col '>>> Service & Port (อัตโนมัติ)' 44) ${Y}│${NC}"
echo -e "${Y}├─$BORDER─┤${NC}"
echo -e "${Y}│${NC} $(pad_col 'SSH Websocket (public)' 30)${G}$(pad_col "$WS_PUB" 14)${NC} ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'SSH Websocket SSL' 30)${G}$(pad_col "$WS_SSL" 14)${NC} ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'SSH WS Internal' 30)${C}$(pad_col "$WS_INT" 14)${NC} ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'Xray (VMESS/VLESS/TROJAN/SS)' 30)$(pad_col "$XRAY_PORT" 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'Open SSH' 30)$(pad_col "$PORT_SSH" 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'Dropbear' 30)$(pad_col "$PORT_DROPBEAR" 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'OpenVPN TCP' 30)$(pad_col '443, 1194' 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'OpenVPN UDP' 30)$(pad_col "$PORT_OVPN_UDP" 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'Nginx Webserver' 30)$(pad_col '443, 80, 81' 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'Haproxy Loadbalancer' 30)$(pad_col "443, $WS_PUB" 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'DNS Server' 30)$(pad_col '443, 53' 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'DNS Client' 30)$(pad_col '443, 88' 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'XRAY Vmess TLS' 30)$(pad_col '443' 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'XRAY Vless TLS' 30)$(pad_col '443' 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'Trojan WS' 30)$(pad_col '443' 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'Shadowsocks WS' 30)$(pad_col '443' 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'BadVPN 1' 30)$(pad_col "7100 [$B1]" 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'BadVPN 2' 30)$(pad_col "7200 [$B2]" 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'BadVPN 3' 30)$(pad_col "7300 [$B3]" 14) ${Y}│${NC}"
echo -e "${Y}│${NC} $(pad_col 'Proxy Squid' 30)$(pad_col "$PORT_SQUID [$SQUID_ST]" 14) ${Y}│${NC}"
echo -e "${Y}└─$BORDER─┘${NC}"
echo ""
echo -e "${W}💡 เปลี่ยนพอร์ต SSH WS: เมนู 21 (Web Panel) → เปลี่ยนพอร์ต SSH WS${NC}"
echo ""
read -n 1 -s -r -p "กดปุ่มใดก็ได้เพื่อกลับไปที่เมนู"
menu
