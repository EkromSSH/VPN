#!/bin/bash
# เปลี่ยนพอร์ต SSH WebSocket - EkromSSH VPN
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'

# อ่านพอร์ตปัจจุบัน
CURRENT=$(grep -oP 'bind\(\("0\.0\.0\.0", \K[0-9]+' /usr/local/bin/ws-ssh.py 2>/dev/null)
[[ -z "$CURRENT" ]] && CURRENT=$(grep -oP 'bind\("0\.0\.0\.0", \K[0-9]+' /usr/local/bin/ws-ssh.py 2>/dev/null || echo "8080")

clear
echo -e "${BLUE}══════════════════════════════════════${NC}"
echo -e "${BLUE}  🔧 เปลี่ยนพอร์ต SSH WebSocket${NC}"
echo -e "${BLUE}══════════════════════════════════════${NC}"
echo ""
echo -e "  ${CYAN}พอร์ตปัจจุบัน:${NC} ${GREEN}${CURRENT}${NC}"
echo ""
read -p "  ➜ ใส่พอร์ตใหม่ (1-65535, Enter = ยกเลิก): " NEW_PORT
[[ -z "$NEW_PORT" ]] && { echo -e "${RED}  ❌ ยกเลิก${NC}"; sleep 1; ssh; exit 0; }

# ตรวจสอบพอร์ต
[[ ! "$NEW_PORT" =~ ^[0-9]+$ || "$NEW_PORT" -lt 1 || "$NEW_PORT" -gt 65535 ]] && {
    echo -e "${RED}  ❌ พอร์ตไม่ถูกต้อง (1-65535)${NC}"; sleep 1; ssh; exit 1
}
[[ "$NEW_PORT" == "$CURRENT" ]] && {
    echo -e "${YELLOW}  ⚠️ พอร์ตเดิมกับใหม่เหมือนกัน${NC}"; sleep 1; ssh; exit 0
}
if ss -tulpn | grep -qP ":${NEW_PORT}\s" 2>/dev/null; then
    echo -e "${RED}  ❌ พอร์ต ${NEW_PORT} ถูกใช้อยู่แล้ว${NC}"
    sleep 1; ssh; exit 1
fi

# เปลี่ยนพอร์ต
sed -i "s/bind((\"0.0.0.0\", ${CURRENT})/bind((\"0.0.0.0\", ${NEW_PORT})/" /usr/local/bin/ws-ssh.py
sed -i "s/bind(\"0.0.0.0\", ${CURRENT})/bind(\"0.0.0.0\", ${NEW_PORT})/" /usr/local/bin/ws-ssh.py
systemctl restart ws-ssh 2>/dev/null
sleep 1

# ตรวจสอบ
if systemctl is-active ws-ssh >/dev/null 2>&1; then
    echo -e "${GREEN}  ✅ เปลี่ยนพอร์ต ${CURRENT} → ${NEW_PORT} สำเร็จ${NC}"
else
    echo -e "${RED}  ❌ เปลี่ยนไม่สำเร็จ กำลังย้อนกลับ...${NC}"
    sed -i "s/bind((\"0.0.0.0\", ${NEW_PORT})/bind((\"0.0.0.0\", ${CURRENT})/" /usr/local/bin/ws-ssh.py
    sed -i "s/bind(\"0.0.0.0\", ${NEW_PORT})/bind(\"0.0.0.0\", ${CURRENT})/" /usr/local/bin/ws-ssh.py
    systemctl restart ws-ssh 2>/dev/null
fi
echo ""
read -n 1 -s -r -p "Press any key"
ssh
